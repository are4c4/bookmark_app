{
  "default_branch": "main",
  "delete_branch_on_merge": true,
  "ruleset": {
    "target": "branch",
    "enforcement": "active",
    "include_default_branch": true,
    "bypass_actors": [],
    "current_user_can_bypass": "never",
    "require_deletion_protection": true,
    "require_non_fast_forward_protection": true,
    "allowed_merge_methods": [
      "squash"
    ],
    "required_status_checks": {
      "strict": true,
      "contexts": [
        "merge-gate"
      ]
    }
  }
}
